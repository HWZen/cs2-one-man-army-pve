{
  // ── 部署配置 ──────────────────────────────────────────────
  // 编辑此文件来添加更多需要复制到 CS2 目录的文件/目录。
  //
  // name:  配置名称（仅用于显示）
  //
  // files: 文件条目列表，每项支持以下字段：
  //
  //   from:
  //     源路径，相对于本程序所在目录，也可填绝对路径。
  //     三种模式：
  //       1. 单文件   "OneManArmyPve.dll"
  //       2. 通配符   "configs/*.json"   （匹配目录下的文件）
  //       3. 目录     "configs/"         （复制整个目录）
  //
  //   to:
  //     目标路径，相对于 CS2 安装目录，也可填绝对路径。
  //     以 / 或 \ 结尾 → 视为目录，保留源文件名。
  //     不以分隔符结尾且源为单文件 → 视为完整目标路径（可重命名）。
  //     通配符/目录模式下 to 始终视为目标目录。
  //
  //   recursive (可选, 默认 false):
  //     通配符模式下搜索子目录并保持相对目录结构。
  //     目录模式下复制子目录。
  //
  //   optional (可选, 默认 false):
  //     源不存在时跳过而不报错。
  //
  "name": "OneManArmyPve",
  "files": [
    {
      "from": "OneManArmyPve.dll",
      "to": "game/csgo/addons/counterstrikesharp/plugins/OneManArmyPve/"
    }
  ]
}
